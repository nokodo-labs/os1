{
	"name": "nokodo-ai-console",
	"version": "0.3.0-rc.2",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "node ../tools/format-summary.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"generate:api-types": "uv run --project ../backend python ../tools/export-openapi.py .openapi-schema.json && openapi-typescript .openapi-schema.json -o src/lib/api/types.ts && node -e \"var f='src/lib/api/types.ts',s=require('fs');s.writeFileSync(f,'// @ts-nocheck\\n'+s.readFileSync(f,'utf8'));try{s.unlinkSync('.openapi-schema.json')}catch(e){}\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/vite": "^4.3.5",
		"@tsconfig/svelte": "^5.0.9",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"openapi-typescript": "^7.13.0",
		"postcss": "^8.5.32",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10.0.0"
	},
	"dependencies": {
		"@xyflow/svelte": "^1.7.1",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"openapi-fetch": "^0.17.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7"
	}
}
