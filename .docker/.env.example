# deployment secrets for docker-compose.yml.
# copy this file to .env and fill in real values before `docker compose up`.

# Postgres credentials (also used to build DATABASE_URL).
POSTGRES_USER=nokodo-ai-admin
POSTGRES_PASSWORD=
POSTGRES_DB=nokodo-ai-production

# backend app secret. generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
NOKODO__SECURITY__SECRET_KEY=

# public origins.
NOKODO__SECURITY__CORS_ORIGINS=https://app.yourdomain.com
NOKODO__BRANDING__PUBLIC_FRONTEND_ORIGIN=https://app.yourdomain.com

# origin browsers use to reach the API (consumed by frontend/console containers).
API_ORIGIN=https://api.yourdomain.com
