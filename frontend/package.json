{
	"name": "frontend",
	"private": true,
	"version": "0.3.0-rc.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "node ../tools/format-summary.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"generate:api-types": "uv run --project ../backend python ../tools/export-openapi.py .openapi-schema.json && openapi-typescript .openapi-schema.json -o src/lib/api/types.ts && node -e \"var f='src/lib/api/types.ts',s=require('fs');s.writeFileSync(f,'// @ts-nocheck\\n'+s.readFileSync(f,'utf8'));try{s.unlinkSync('.openapi-schema.json')}catch(e){}\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.4",
		"@tailwindcss/vite": "^4.3.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"@types/three": "^0.187.0",
		"@vitest/coverage-v8": "^5.1.0",
		"@vitest/ui": "^5.1.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"openapi-typescript": "^7.13.0",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@dayflow/core": "^3.7.6",
		"@dayflow/plugin-drag": "^1.6.2",
		"@dayflow/svelte": "^3.7.6",
		"@floating-ui/dom": "^1.8.0",
		"@humanspeak/svelte-virtual-list": "^0.5.15",
		"@internationalized/date": "^3.12.4",
		"@tiptap/core": "^3.33.0",
		"@tiptap/extension-placeholder": "^3.33.0",
		"@tiptap/extension-typography": "^3.33.0",
		"@tiptap/extension-underline": "^3.33.0",
		"@tiptap/pm": "^3.33.0",
		"@tiptap/starter-kit": "^3.33.0",
		"@types/turndown": "^5.0.5",
		"clsx": "^2.1.1",
		"marked": "^18.1.3",
		"mermaid": "^12.3.0",
		"ogl": "^1.0.11",
		"openapi-fetch": "^0.17.0",
		"prosemirror-keymap": "^1.2.3",
		"svelte-streamdown": "5.0.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.4",
		"three": "^0.187.0",
		"tippy.js": "^6.3.7",
		"tslib": "^2.9.1",
		"turndown": "^7.2.5",
		"tw-animate-css": "^1.4.0",
		"y-prosemirror": "^1.3.7",
		"yjs": "^13.6.33"
	}
}
